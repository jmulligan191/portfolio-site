# Environment
NODE_ENV="development"
PORT=1910
NEXT_PUBLIC_DOMAIN="example.com"

# Cloudflare Web Analytics
NEXT_PUBLIC_ENABLE_CF_ANALYTICS="false"
NEXT_PUBLIC_CF_BEACON_URL="https://static.cloudflareinsights.com/beacon.min.js"
NEXT_PUBLIC_CF_ANALYTICS_TOKEN="your-cloudflare-analytics-token"

# Sentry Error Tracking
NEXT_PUBLIC_SENTRY_DSN="your-sentry-dsn-public"

# Resume export tracking (see docs/resume-tracking.md)
# Path to the sqlite tracking DB. Defaults to ./data/tracking.db if unset.
TRACKING_DB_PATH="./data/tracking.db"
# SHA-256 hash of the local resume repo's bearer key for POST /api/resume-exports.
# Generate a key/hash pair with: node scripts/generate-resume-export-key.mjs
RESUME_EXPORT_API_KEY_HASH="your-sha256-hash-here"

# Resume repo sync (see docs/resume-tracking.md) — periodically checks
# github.com/Outlandish0191/resume (private) for a new root .pdf and, if
# changed, downloads it as the new default resume.
RESUME_SOURCE_REPO="Outlandish0191/resume"
# GitHub PAT (fine-grained, read-only, scoped to that one repo) with access
# to the repo above. Required — sync is a no-op without it.
RESUME_SOURCE_GITHUB_TOKEN="your-github-pat-here"
# How often the in-process timer checks for updates. Defaults to 30.
RESUME_SYNC_INTERVAL_MINUTES=30